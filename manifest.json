{
  "manifest_version": 3,
  "name": "Помічник сурдо-перекладу",
  "version": "1.6.2",
  "description": "Зчитує субтитри та показує ASL/CSL-прототипи на гладкій сяючій 3D-кисті з прихованим 21-точковим rig.",
  "minimum_chrome_version": "116",
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "offscreen",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Помічник сурдо-перекладу",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/three.global.js", "avatar3d.js", "signs.js", "fingerspell.js", "assistant.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["reader.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
